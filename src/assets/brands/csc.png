  <script>
	function toggleMenuIcon() {
		const icon = document.querySelector('.bartoggle i');
		
		// Check if the icon is currently the hamburger (bars)
		if (icon.classList.contains('fa-bars')) {
			// Replace with cross (X)
			icon.classList.remove('fa-bars');
			icon.classList.add('fa-xmark');
		} else {
			// Replace with hamburger (bars)
			icon.classList.remove('fa-xmark');
			icon.classList.add('fa-bars');
		}
	}

	// Event listener to toggle the icon when clicked
	//document.querySelector('.bartoggle').addEventListener('click', toggleMenuIcon);
</script>

