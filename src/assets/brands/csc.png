<script>
       function get_data(event, type) {
            // Ensure the `event` is a jQuery object
            var $clickedButton = $(event);

            // Remove 'active' class from all buttons
            $('.btn').removeClass('activetab');

            // Add 'active' class to the clicked button

            $.ajax({
            url: '/datamodel',
            type: 'POST',
            data: {
                type: type
            },
            //dataType: 'json',
            success: function(data) {
                $('#product-range-container').html("");
                $clickedButton.addClass('activetab');
                $('#product-range-container').html(data);
            },
            error: function(jqXHR, textStatus, errorThrown) {
            }
            });
        }

        function removeselecteditem(item_id,item_type) {
			//alert("hello");
			//alert(item_id);
            $.ajax({
            url: '/remove_data',
            type: 'POST',
            data: {
                item_type: item_type,
                item_id: item_id
            },
            
            //dataType: 'json',     
            success: function(data) {
                if (item_type == 'category') { 	
                $("#category" + item_id).prop("checked", false);
                //item_id.replace(/-/g, ' ');
                //alert("1");
                }
                if (item_type == 'applications') {
                $("#application" + item_id).prop("checked", false);
                //alert("12");
                }
                if (item_type == 'series') {
                $("#series" + item_id).prop("checked", false);
                // item_id.replace(/-/g, ' ');
               // item_id.replace(/-/g, ' ');
                //alert("13");
                }
                $("#showitemselected"+item_id).remove();
                //$('#product-list').html(data);
                get_product(item_type);
            }
            });
        }

        function set_data(item_type) {
            var categoryselectedValues = [];
            var seriesselectedValues = [];
            var applicationselectedValues = [];
            // Loop through all checked checkboxes and push their values
            $('input[name="category[]"]:checked').each(function() {
            categoryselectedValues.push($(this).val());
            });
            $('input[name="series[]"]:checked').each(function() {
            seriesselectedValues.push($(this).val());
            });
            $('input[name="application[]"]:checked').each(function() {
            applicationselectedValues.push($(this).val());
            });
            
            $.ajax({
            url: '/set_data',
            type: 'POST',
            data: {
                item_type: item_type,
                category: categoryselectedValues,
                series: seriesselectedValues,
                application: applicationselectedValues
            },
            //dataType: 'json',     
            success: function(data) {
                $("#showselecteditem").html(data);
                if ($('#showselecteditem .itemname').length > 0) {
                // Show the "Active" paragraph if .itemname is found
                $('#activepara').show();
                } else {
                // Hide the "Active" paragraph if .itemname is not found
                $('#activepara').remove();
                }
            }
            });
        }

        function get_product(item_type) {
            set_data(item_type);
            $.ajax({
            url: '/get_products',
            type: 'POST',
            data: {
                item_type: item_type
            },
            //dataType: 'json',    
            success: function(data) {
                $('#product-list').html("");
                $('#product-list').html(data);
                
            },
            error: function(jqXHR, textStatus, errorThrown) {

            }
            });
        }

        function clear_filter() {
            $.ajax({
            url: '/clear_filter',
            type: 'POST',
            //dataType: 'json',    
            success: function(data) {
                $('.item-category').prop('checked', false);
                $("#showselecteditem").html('');
            }
            });
        }
        // Function to animate the counter
        function animateCounter(element) {
            const target = parseInt(element.getAttribute('data-target'));
            let current = 0;
            const updateInterval = setInterval(() => {
                current += Math.ceil(target / 50); // Adjust speed here
                element.textContent = current;
                if (current >= target) {
                    element.textContent = target;
                    clearInterval(updateInterval);
                }
            }, 50);
        }
        //counter
        document.addEventListener('DOMContentLoaded', () => {
            const counters = document.querySelectorAll('.counter');
            if (counters) {
                counters.forEach(counter => {
                    animateCounter(counter);
                });
            }
        });
    </script>
